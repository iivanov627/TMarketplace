@startuml c4-catalog-code

title Catalog Service - Code Structure (conceptual)

skinparam classAttributeIconSize 0
hide empty members

' NOTE: US-25 in USM says new product is active; updated seller scenario says it enters moderation.
' Resolve this requirement conflict before implementation.

package "catalog-service" {
    package "controller" {
        class ProductController {
            +createProduct(request)
            +updateProduct(id, request)
            +submitForModeration(id)
            +hideProduct(id)
            +restoreProduct(id)
            +archiveProduct(id)
            +deleteProduct(id)
            +getProduct(id)
        }
    }

    package "service" {
        class ProductService {
            +createProduct(request)
            +updateProduct(id, request)
            +hideProduct(id)
            +restoreProduct(id)
            +archiveProduct(id)
            +deleteProduct(id)
        }

        class ModerationService {
            +approveProduct(id)
            +rejectProduct(id, reason)
        }

        class InventoryService <<optional: R2-06/R2-07>> {
            +updateStock(id, quantity)
            +checkAvailability(id)
        }
    }

    package "domain" {
        class Product {
            -id: UUID
            -sellerId: UUID
            -name: String
            -description: JSON
            -categoryId: UUID
            -price: BigDecimal
            -status: ProductStatus
            -imageIds: List<UUID>
        }

        enum ProductStatus {
            DRAFT
            MODERATION
            ACTIVE
            HIDDEN
            ARCHIVED
            DELETED
        }
    }

    package "repository" {
        interface ProductRepository {
            +save(product): Product
            +findById(id): Product
            +findBySellerId(sellerId): List<Product>
            +existsInOrders(productId): boolean
        }

        interface OutboxRepository {
            +save(event): void
            +findPendingEvents(): List<OutboxEvent>
        }
    }

    package "messaging" {
        class OutboxEvent {
            -eventId: UUID
            -eventType: String
            -payload: String
            -createdAt: Instant
        }

        class OutboxPublisher {
            +publishPendingEvents()
        }
    }

    package "integration" {
        class ImageStorageAdapter {
            +upload(file): UUID
        }

        class SearchIndexAdapter {
            +indexProduct(product)
            +removeFromIndex(productId)
        }
    }
}

ProductController --> ProductService
ProductService --> ProductRepository
ProductService --> ModerationService
ProductService --> InventoryService
ProductService --> ImageStorageAdapter
ProductService --> SearchIndexAdapter
ProductService --> OutboxRepository
ProductRepository --> Product
OutboxRepository --> OutboxEvent
OutboxPublisher --> OutboxRepository
OutboxPublisher --> OutboxEvent

@enduml
