
@startuml c3-order
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title C3 — order-service Components

Container_Boundary(order, "order-service") {

    Component(controller, "OrderController", "REST Controller",
        "Создание заказов и получение истории")

    Component(service, "OrderService", "Application Service",
        "Управление жизненным циклом заказа")

    Component(factory, "OrderFactory", "Domain Component",
        "Формирование заказа и OrderItems")

    Component(status, "OrderStatusService", "Domain Service",
        "Проверка допустимых переходов статусов")

    Component(saga, "OrderSagaOrchestrator", "Application Component",
        "Координация оплаты и списания бонусов")

    Component(payment, "PaymentAdapter", "Integration Adapter",
        "Интеграция с демо-оплатой")

    Component(repository, "OrderRepository", "Repository",
        "Хранение заказов")

    Component(consumer, "OrderEventConsumer", "Kafka Consumer",
        "Обработка результатов оплаты и бонусных операций")

    Component(producer, "OrderEventPublisher", "Kafka Producer",
        "Публикация событий заказов через Outbox")
}

ContainerDb(db, "PostgreSQL", "Database")
ContainerQueue(kafka, "Kafka", "Message Broker")
Container(bonus, "bonus-service", "Spring Boot", "Бонусные операции")
Container(cart, "cart-service", "Spring Boot", "Корзина")
Container(catalog, "catalog-service", "Spring Boot", "Каталог")

Rel(controller, service, "Вызывает")
Rel(service, factory, "Создаёт заказ")
Rel(service, status, "Проверяет переходы")
Rel(service, repository, "Чтение/запись")
Rel(service, saga, "Запускает процесс оформления")
Rel(saga, payment, "Инициирует оплату")
Rel(saga, producer, "Публикует команды")
Rel(repository, db, "SQL")
Rel(consumer, saga, "Передаёт результаты")
Rel(producer, kafka, "Публикует order.events")
Rel(kafka, consumer, "События bonus/payment")
Rel(saga, cart, "REST: получить/очистить корзину")
Rel(saga, catalog, "REST: проверить товары")

Rel(kafka, bonus, "Bonus commands")

@enduml
