# Copy to .env and set a private random JWT_SECRET shared by both local services.
JWT_SECRET=replace-with-base64-secret
JWT_ISSUER=auth-service
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

AUTH_SERVER_PORT=8081
AUTH_DATABASE_URL=jdbc:postgresql://localhost:5432/auth_db
AUTH_DATABASE_USERNAME=postgres
AUTH_DATABASE_PASSWORD=change-me

CATALOG_SERVER_PORT=8080
CATALOG_DATABASE_URL=jdbc:postgresql://localhost:5432/catalog_db
CATALOG_DATABASE_USERNAME=postgres
CATALOG_DATABASE_PASSWORD=change-me
ELASTICSEARCH_URI=http://localhost:9200
