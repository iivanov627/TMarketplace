# Copy this file to .env before starting the Compose stack.
# Replace this placeholder with a private Base64-encoded secret of at least 32 bytes.
JWT_SECRET=replace-with-base64-secret
JWT_ISSUER=auth-service
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

AUTH_SERVER_PORT=8081
AUTH_DATABASE_URL=jdbc:postgresql://auth-db:5432/auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=local_auth_password

CATALOG_SERVER_PORT=8082
CATALOG_DATABASE_URL=jdbc:postgresql://catalog-db:5432/catalog_db
CATALOG_DATABASE_USERNAME=catalog_user
CATALOG_DATABASE_PASSWORD=local_catalog_password
CATALOG_DB_USER=catalog_user
CATALOG_DB_PASSWORD=local_catalog_password
ELASTICSEARCH_URI=http://elasticsearch:9200
